{
  "name": "slopculator",
  "version": "0.1.0-alpha.1",
  "license": "MIT",
  "private": true,
  "description": "Keyboard-first calculator and grapher: web app and Windows app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ferro-5G/slopculator.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc-rs --noEmit -p tsconfig.json",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "e2e": "node scripts/e2e.mjs && node scripts/audit-e2e.mjs",
    "verify": "npm run lint && npm test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "playwright-core": "^1.64.1",
    "tsc-rs": "^0.8.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0"
  }
}
